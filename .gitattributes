# ====================================================================
# Git Attributes for Android & Kotlin Project
# ====================================================================

# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted to native line endings on checkout
*.kt text diff=kotlin
*.kts text diff=kotlin
*.java text diff=java
*.xml text
*.json text
*.md text
*.properties text
*.toml text
*.txt text
*.gradle text
*.pro text

# Ensure batch files keep CRLF line endings for Windows execution
*.bat text eol=crlf
*.cmd text eol=crlf

# Ensure shell scripts always keep LF line endings for Unix execution
gradlew text eol=lf
*.sh text eol=lf

# Declare binary files to prevent Git from attempting to modify or merge line endings
*.jar binary
*.aar binary
*.apk binary
*.aab binary
*.so binary
*.dex binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.keystore binary
*.jks binary
