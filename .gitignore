# ====================================================================
# Android & Kotlin Modern Standard .gitignore
# ====================================================================

# Built application files
*.apk
*.aar
*.aab
*.ap_

# Files for the ART/Dalvik VM
*.dex

# Java & Kotlin class files
*.class

# Generated files
bin/
gen/
out/
build/
*/build/
app/build/

# Gradle files
.gradle/
buildOutput/

# Local configuration file (contains SDK/NDK path, sensitive info)
local.properties

# Proguard / R8 folder and cache
proguard/

# Log files
*.log

# Android Studio / IntelliJ IDEA
*.iml
*.ipr
*.iws
.idea/
!.idea/codeStyles/
!.idea/copyright/
!.idea/misc.xml
!.idea/inspectionProfiles/

# Keystore and signing keys
*.jks
*.keystore
signing.properties

# Native build caches and temporary files
.externalNativeBuild
.cxx
ndkBuild/

# Kotlin / KSP / Kapt
.kotlin/
.ksp/

# Google Services / Firebase (credentials)
# google-services.json

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Editors & Temporary files
*~
*.swp
*.swo
.vscode/
.fleet/
